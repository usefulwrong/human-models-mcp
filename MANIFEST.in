include README.md LICENSE CITATION.cff CONTRIBUTING.md CHANGELOG.md SECURITY.md requirements.in requirements.lock models.lock.json Makefile Dockerfile compose.yaml .dockerignore
recursive-include scenarios *.yaml *.md
recursive-include skills *.md
recursive-include docs *.md
prune docs/demo
recursive-include scripts *.py *.sh
recursive-include scripts/anatomy_lab *.css *.html *.html.in *.js *.json
recursive-include scripts/muscle_intelligence *.cjs *.js *.json *.patch
exclude scripts/anatomy_lab/build_report.py scripts/muscle_intelligence/package_review.py scripts/muscle_intelligence/review_media.py
prune scripts/anatomy_lab/report_site
prune scripts/anatomy_lab/site/npm/node_modules
recursive-include examples *.py *.toml *.md
recursive-include notices *
recursive-include tests *.py *.json
prune tests/anatomy_lab_e2e/prototypes
recursive-include benchmarks *.xml *.csv *.json *.md
recursive-include .github *.yml *.yaml

include Dockerfile.render Dockerfile.render.dockerignore compose.render-gpu.yaml renderer.lock.json requirements-render.lock visual_sources.json
global-exclude *.orig *.rej *.pyc

include README-WINDOWS.md Start.cmd Install.cmd Doctor.cmd Stop.cmd .gitattributes
include dependencies-windows-x64.json requirements-windows-x64.lock requirements-render-windows-x64.lock requirements-dev-windows-x64.lock
include setup.cfg
recursive-include scripts/windows *.cmd *.ps1
recursive-include qa/windows *.bat *.md *.ps1 *.py *.sh *.yaml
